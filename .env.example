# Baton — environment contract.
#
# Copy to .env for local development. Never commit .env.
#
# On the VM these values live in Coolify's per-resource environment
# configuration, not in a file beside the code. The agent's variables are set on
# the AgentCore runtime at launch. The consequence is that MODEL_API_KEY never
# touches the VM and DATABASE_URL never reaches AWS — neither side holds the
# other's secrets.

# ───────────────────────────────────────────────────────────────────────────────
# worker
# ───────────────────────────────────────────────────────────────────────────────

# Port 5433, not 5432: docker-compose.dev.yml publishes 127.0.0.1:5433:5432 so a
# local Postgres already listening on 5432 cannot be connected to by accident.
DATABASE_URL=postgres://baton:baton@localhost:5433/baton

# A SEPARATE database, used only by integration tests, which truncate between
# cases. The harness refuses to run when this equals DATABASE_URL — a truncating
# test pointed at the working database would destroy the demo's golden state.
TEST_DATABASE_URL=postgres://baton:baton@localhost:5433/baton_test

# From BotFather. Use a SEPARATE bot for local development: a bot token supports
# exactly one getUpdates consumer, so polling the deployed bot's token from a
# local worker splits the update stream and breaks both.
TELEGRAM_BOT_TOKEN=
# The one chat id that is processed. Messages from any other chat are ignored.
TELEGRAM_CHAT_ID=
# Only this person can answer an approval. Verification and clarification
# questions accept an answer from anyone in the group.
COORDINATOR_TELEGRAM_ID=

# agentcore | http
#   agentcore  signs with SigV4 against AGENTCORE_RUNTIME_ARN (deployed)
#   http       POSTs to AGENT_HTTP_URL (local, agent container run locally)
AGENT_TRANSPORT=http

# Required when AGENT_TRANSPORT=http
AGENT_HTTP_URL=http://localhost:8080

# Required when AGENT_TRANSPORT=agentcore
AGENTCORE_RUNTIME_ARN=
AWS_REGION=
# The only AWS credential in the system. Scope this IAM user to
# bedrock-agentcore:InvokeAgentRuntime and nothing else.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bearer token the agent presents to the worker's read-only data API. Shared
# with the agent below; any long random string.
DATA_API_TOKEN=

# Relative dates resolve against this, not UTC. At IST, UTC would shift dates by
# a day and look like a bug in provenance.
ORG_TIMEZONE=Asia/Kolkata

# Worker HTTP port: serves /health and /data/*.
PORT=8081
# Agent container HTTP port: serves /invocations and /ping.
# Separate from PORT because locally both processes read one .env, and the agent
# binding the worker's port makes AGENT_HTTP_URL unreachable. Unset when deployed:
# AgentCore sets PORT itself.
AGENT_PORT=8080

# ───────────────────────────────────────────────────────────────────────────────
# agent
# ───────────────────────────────────────────────────────────────────────────────

# OpenAI-compatible endpoint for the model provider.
MODEL_BASE_URL=
MODEL_API_KEY=

# Fallback for any *_MODEL left unset.
DEFAULT_MODEL=deepseek-chat

# Per-agent models. The Curator runs on every candidate message and dominates
# cost and latency; the Assessor, Restraint and Briefer produce the prose a
# reader actually judges, so those three can be pointed at a stronger model
# without touching the one that dominates cost.
CURATOR_MODEL=
CARTOGRAPHER_MODEL=
ASSESSOR_MODEL=
RESTRAINT_MODEL=
BRIEFER_MODEL=
RESPONDENT_MODEL=

# Where the agent's Strands tools reach the worker's read-only data API. Must be
# a URL the agent's container can actually resolve: publicly routable when
# deployed, localhost when the agent runs locally.
DATA_API_URL=http://localhost:8081/data

# ───────────────────────────────────────────────────────────────────────────────
# web
# ───────────────────────────────────────────────────────────────────────────────

# The passcode judges are given. Exchanged for a signed session cookie; there is
# no user table.
ADMIN_PASSCODE=
# Signing secret for that cookie. Any long random string.
SESSION_SECRET=

# ───────────────────────────────────────────────────────────────────────────────
# local Postgres (docker-compose.dev.yml only)
# ───────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=baton
POSTGRES_PASSWORD=baton
POSTGRES_DB=baton
