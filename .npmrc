# Fail fast if the local Node does not satisfy the engines field, rather than
# failing later inside a Docker build with a less obvious error.
engine-strict=true

# Keep the lockfile authoritative. CI and Docker builds use --frozen-lockfile.
save-exact=true

# Workspace packages resolve to the local copy, never the registry. Without this
# a typo in a @baton/* dependency silently fetches nothing and fails obscurely.
link-workspace-packages=true
prefer-workspace-packages=true
